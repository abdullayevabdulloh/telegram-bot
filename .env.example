NODE_ENV=development
LOG_LEVEL=info
MONGODB_URI=mongodb://localhost:27017/edugen
REDIS_URL=redis://localhost:6379
# Bot havolalari uchun (2-bosqich: web)
WEB_URL=http://localhost:3000

# --- AI (asosiy) ---
OPENAI_API_KEY=
# OpenAI-ga mos boshqa provayder uchun (bo'sh bo'lsa api.openai.com). Gemini:
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
OPENAI_BASE_URL=
# Model nomini shu yerda tanlang (kodga qattiq yozilmaydi)
OPENAI_MODEL=
# AI matn tugmalari uchun tezroq/arzonroq model; bo'sh bo'lsa OPENAI_MODEL ishlatiladi
OPENAI_MODEL_FAST=
OPENAI_TIMEOUT_MS=120000

# --- AI (zaxira, ixtiyoriy) ---
# Claude (Anthropic): asosiy AI ishlamasa avtomatik ishlatiladi. Kalit bo'sh bo'lsa zaxira o'chirilgan.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_TIMEOUT_MS=300000

# --- Worker ---
WORKER_CONCURRENCY=5

# --- Bot ---
BOT_TOKEN=
# Bo'sh bo'lsa polling (lokal); prod'da: https://bot.example.com
BOT_WEBHOOK_DOMAIN=
BOT_WEBHOOK_SECRET=
BOT_WEBHOOK_PORT=8080
# Vergul bilan: 12345678,87654321
ADMIN_IDS=
